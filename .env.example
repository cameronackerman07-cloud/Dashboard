# Copy the NAMES below into Vercel → Project → Settings → Environment Variables.
# Paste the real values there, never into this file, GitHub or chat.

# --- AI ---
# Everyone pastes their own free AI keys in Settings > AI keys. These site keys are a fallback:
# SHARED_AI_FOR_FRIENDS = off (only OWNER_EMAIL may use them) | limited (10 calls a day each) | on
SHARED_AI_FOR_FRIENDS=off
OWNER_EMAIL=
# AI_MOCK=1 returns canned answers (testing only; never set it in production)
AI_MOCK=
# Site keys (free tiers, tried in this order)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# Optional: override a provider's first model when a free model name changes.
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=

# --- Supabase (login, database, file uploads) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron sends this with the daily flashcard duplicate check.
CRON_SECRET=

# --- Google (Calendar, Drive, Classroom) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify (now playing) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Encrypts saved keys and tokens (AES-256-GCM) ---
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: if it's lost, every saved key and connection is unreadable.
TOKEN_ENCRYPTION_KEY=
# Only while rotating: the old key, so old rows still decrypt (then run npm run reencrypt)
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- Push notifications (npm run vapid prints a pair) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your site URL, e.g. https://your-dashboard.vercel.app
VAPID_SUBJECT=
SITE_URL=

# --- Scheduled agents ---
# Long random secret. The GitHub Actions scheduler sends it to /api/agents/tick.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Also add SITE_URL and AGENT_SECRET as GitHub repo secrets (Settings → Secrets and variables → Actions).
AGENT_SECRET=

# --- Optional real SMS (OFF; costs money per message in Australia, see lib/sms.ts) ---
SMS_ENABLED=
SMS_PROVIDER=
SMS_API_KEY=
