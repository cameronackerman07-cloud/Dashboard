# Copy the NAMES below into Vercel → Project → Settings → Environment Variables.
# Paste the real values there, never into this file, GitHub or chat.
# (Nothing here is needed yet — these switch on in later phases.)

# --- AI models (free tiers, tried in this order) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Supabase (login, database, file uploads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (Calendar, Drive, Classroom) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify (now playing) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Encrypts saved tokens such as your Canvas access token ---
TOKEN_ENCRYPTION_KEY=
