# Copy the NAMES below into Vercel → Project → Settings → Environment Variables.
# Paste the real values there, never into this file, GitHub or chat.

# --- AI models (free tiers, tried in this order) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# Optional: override a provider's first model when a free model name changes.
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=

# --- Supabase (login, database, file uploads) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Accounts ---
# Friends must type this code to create an account (leave empty and anyone can join).
INVITE_CODE=
# Vercel Cron sends this with the daily flashcard duplicate check.
CRON_SECRET=

# --- Google (Calendar, Drive, Classroom) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify (now playing) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Encrypts saved tokens such as your Canvas access token ---
TOKEN_ENCRYPTION_KEY=
